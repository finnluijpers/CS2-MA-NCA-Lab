Vagrant.configure("2") do |config|
  config.vm.box = "bento/ubuntu-24.04" # Ubuntu 24.04 LTS (dit is Mware compatible)

  # Synchroniseer de complete bovenliggende projectmap naar /lab in de VM
  config.vm.synced_folder "..", "/lab"

  # standaard VMware Workstation Pro gebruiken
  config.vm.provider "vmware_desktop" do |v|
    v.gui = false
  end

  # app01 - Web Application Server, load Balancer & Monitoring Hub
  config.vm.define "app01" do |app01|
    app01.vm.hostname = "app01"
    app01.vm.network "private_network", ip: "192.168.88.10"
    app01.vm.provider "vmware_desktop" do |v|
      v.vmx["memsize"] = "2048" # Extra geheugen voor de volledige monitoring stack
      v.vmx["numvcpus"] = "2"
    end

    # automatische provisioning via Ansible of shell script bij vagrant up
    app01.vm.provision "shell", inline: <<-SHELL
      echo "=== Start automatische inrichting monitoring stack op app01 ==/lab"
      sudo apt-get update
      sudo apt-get install -y docker.io docker-compose-v2
      sudo usermod -aG docker vagrant
      
      # Start de Docker Compose stack vanuit de gesynchroniseerde map
      cd /lab
      if [ -f "docker-compose.yml" ]; then
        docker compose up -d
        echo "=== Monitoring stack succesvol gestart! ==="
      else
        echo "Waarschuwing: docker-compose.yml nog niet gevonden in /lab"
      fi
    SHELL
  end

  # app02 - workstation / Secondary Server
  config.vm.define "app02" do |app02|
    app02.vm.hostname = "app02"
    app02.vm.network "private_network", ip: "192.168.88.11"
    app02.vm.provider "vmware_desktop" do |v|
      v.vmx["memsize"] = "1024"
      v.vmx["numvcpus"] = "1"
    end
    app02.vm.provision "shell", inline: <<-SHELL
      sudo apt-get update && sudo apt-get install -y docker.io
      docker run -d --net="host" --pid="host" -v "/:/host:ro,rslave" --name node-exporter prom/node-exporter --path.rootfs=/host
    SHELL
  end

  # db01 - On Prem database Server
  config.vm.define "db01" do |db01|
    db01.vm.hostname = "db01"
    db01.vm.network "private_network", ip: "192.168.88.12"
    db01.vm.provider "vmware_desktop" do |v|
      v.vmx["memsize"] = "1024"
      v.vmx["numvcpus"] = "1"
    end
    db01.vm.provision "shell", inline: <<-SHELL
      sudo apt-get update && sudo apt-get install -y docker.io
      docker run -d --net="host" --pid="host" -v "/:/host:ro,rslave" --name node-exporter prom/node-exporter --path.rootfs=/host
    SHELL
  end
end